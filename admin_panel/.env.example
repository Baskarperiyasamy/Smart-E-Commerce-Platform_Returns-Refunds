# Rename this file to .env before running the project.
# Use the SAME MySQL and SMTP values you already have in
# fastapi_backend/.env — this Django project reads and writes the exact
# same ecommerce_db database.

DJANGO_SECRET_KEY=change_this_to_a_long_random_secret_key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (same ecommerce_db as fastapi_backend) ---
DB_NAME=ecommerce_db
DB_USER=root
DB_PASSWORD=baskar123
DB_HOST=localhost
DB_PORT=3306

# --- Email (same values as fastapi_backend/.env) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=SmartCart

# --- Analytics ---
LOW_STOCK_THRESHOLD=10
