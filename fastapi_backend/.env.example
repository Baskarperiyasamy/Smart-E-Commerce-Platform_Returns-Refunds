# Rename this file to .env before running the project

# --- Database ---
# MySQL (default for this project — create the schema first in MySQL Workbench,
# see README section "MySQL Setup" for exact steps).
# Format: mysql+pymysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/ecommerce_db

# To use SQLite instead (zero setup, good for quick local testing), comment
# the line above and uncomment this one:
# DATABASE_URL=sqlite:///./ecommerce.db

# --- JWT ---
SECRET_KEY=change_this_to_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Auth0 (Social Login: Google / Facebook) ---
# Create a free account at https://auth0.com
# Create an "Application" (Regular Web App or SPA) and a Google/Facebook
# social connection under Authentication > Social in the Auth0 dashboard.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/
AUTH0_ALGORITHMS=RS256

# --- Cart ---
TAX_RATE=0.08

# --- Stripe (Checkout + Payments) ---
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Get this after running `stripe listen --forward-to localhost:8000/webhooks/stripe`
# (Stripe CLI) — it prints a whsec_... value to use here for local testing.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_CURRENCY=usd

# Where Stripe redirects the browser after checkout. Point these at your
# frontend (served on 5500 by `python -m http.server 5500` from /frontend).
CHECKOUT_SUCCESS_URL=http://127.0.0.1:5500/order-success.html?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=http://127.0.0.1:5500/cart.html

# --- Email Notifications (Day 4) — SMTP ---
# For Gmail: use an "App Password" (not your normal password) — generate one
# at https://myaccount.google.com/apppasswords (requires 2FA enabled).
# For quick local testing without a real inbox, use https://mailtrap.io instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=SmartCart
